<resources>
    <style name="Theme.Kosh" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- The launch splash draws the icon on the dark window; the white disc keeps the black wallet visible. -->
        <item name="android:windowSplashScreenBackground">@color/ink</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
